<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KksSceneConv</AssemblyName>
    <RootNamespace>KksSceneConv</RootNamespace>
    <Version>1.0.0</Version>
    <Product>KKS to KK Scene Converter</Product>
    <AssemblyTitle>KKS to KK Scene Converter</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WinForms is not supported in globalization-invariant mode (CultureNotFoundException on dialogs). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

</Project>
